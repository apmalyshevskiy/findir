# ══════════════════════════════════════════════════════════════════
#  FINDIR — ПРОДАКШН .env  (скопировать в back/.env на сервере)
#  cp deploy/env.prod.example back/.env  →  заполнить CHANGE_ME
# ══════════════════════════════════════════════════════════════════

APP_NAME=FINDIR
APP_ENV=production
APP_DEBUG=false
# Сгенерировать: docker compose -f docker-compose.prod.yml run --rm php php artisan key:generate --show
APP_KEY=CHANGE_ME
APP_URL=https://findir.161-104-34-180.sslip.io
APP_BASE_DOMAIN=findir.161-104-34-180.sslip.io

LOG_CHANNEL=stack
LOG_LEVEL=warning

# ── БД: существующий контейнер MariaDB fp_site-db-1 ───────────────
# Доступен по имени контейнера через внешнюю сеть fp_site_default.
DB_CONNECTION=mysql
DB_HOST=fp_site-db-1
DB_PORT=3306
DB_DATABASE=findir_central
DB_USERNAME=findir
DB_PASSWORD=CHANGE_ME

# ── Redis (в docker-сети) ─────────────────────────────────────────
CACHE_STORE=redis
SESSION_DRIVER=redis
QUEUE_CONNECTION=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

# ── Почта (заполнить реальным SMTP или оставить log) ──────────────
MAIL_MAILER=log
MAIL_HOST=127.0.0.1
MAIL_PORT=1025
MAIL_FROM_ADDRESS=noreply@findir.161-104-34-180.sslip.io
MAIL_FROM_NAME=FINDIR
