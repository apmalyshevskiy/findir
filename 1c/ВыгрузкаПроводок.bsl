////////////////////////////////////////////////////////////////////////////////
// Модуль объекта внешней обработки «Выгрузка проводок в FINDIR».
//
// Выгружает движения регистра бухгалтерии «Хозрасчетный» за период в JSON
// формата findir-postings (описание — в FORMAT.md рядом с этим файлом).
//
// Почему не штатный отчёт «Журнал проводок»: в отчёте нет GUID регистратора,
// а без него повторная выгрузка того же месяца создаёт дубли на приёмнике.
// Заодно берём ИНН контрагентов и имена видов субконто — по ним аналитика
// сопоставляется точнее, чем по одному представлению.
//
// Проверено на: Бухгалтерия предприятия 3.0, платформа 8.3.
////////////////////////////////////////////////////////////////////////////////

////////////////////////////////////////////////////////////////////////////////
// Регистрация в справочнике дополнительных обработок (БСП)

Функция СведенияОВнешнейОбработке() Экспорт

	ПараметрыРегистрации = Новый Структура;
	ПараметрыРегистрации.Вставить("Вид", "ДополнительнаяОбработка");
	ПараметрыРегистрации.Вставить("Наименование", "Выгрузка проводок в FINDIR");
	ПараметрыРегистрации.Вставить("Версия", ВерсияОбработки());
	ПараметрыРегистрации.Вставить("БезопасныйРежим", Ложь); // пишем файл на диск
	ПараметрыРегистрации.Вставить("Информация",
		"Выгружает проводки за период в файл JSON для загрузки в FINDIR.");
	ПараметрыРегистрации.Вставить("Назначение", Новый Массив);
	ПараметрыРегистрации.Вставить("Команды", Новый ТаблицаЗначений);

	ПараметрыРегистрации.Команды.Колонки.Добавить("Представление");
	ПараметрыРегистрации.Команды.Колонки.Добавить("Идентификатор");
	ПараметрыРегистрации.Команды.Колонки.Добавить("Использование");
	ПараметрыРегистрации.Команды.Колонки.Добавить("ПоказыватьОповещение");
	ПараметрыРегистрации.Команды.Колонки.Добавить("Модификатор");

	Команда = ПараметрыРегистрации.Команды.Добавить();
	Команда.Представление = "Выгрузить проводки в FINDIR";
	Команда.Идентификатор = "ВыгрузкаПроводок";
	Команда.Использование = "ОткрытиеФормы";
	Команда.ПоказыватьОповещение = Ложь;

	Возврат ПараметрыРегистрации;

КонецФункции

////////////////////////////////////////////////////////////////////////////////
// Основное

// Собирает структуру выгрузки за период.
//
// Параметры:
//   ДатаНачала    - Дата
//   ДатаОкончания - Дата, включается целиком (до 23:59:59)
//   Организация   - СправочникСсылка.Организации, может быть пустой ссылкой —
//                   тогда выгружаются все организации
//
// Возвращаемое значение:
//   Структура - готовая к записи в JSON, см. FORMAT.md
//
Функция СобратьВыгрузку(ДатаНачала, ДатаОкончания, Организация) Экспорт

	// Конец дня, а не сама дата: иначе проводки последнего дня, сделанные
	// после полуночи, в выгрузку не попадут
	ГраницаКонца = КонецДня(ДатаОкончания);

	Запрос = Новый Запрос;
	Запрос.УстановитьПараметр("ДатаНачала", НачалоДня(ДатаНачала));
	Запрос.УстановитьПараметр("ДатаОкончания", ГраницаКонца);
	Запрос.УстановитьПараметр("Организация", Организация);
	Запрос.УстановитьПараметр("ОтборПоОрганизации", ЗначениеЗаполнено(Организация));

	// Источник — виртуальная таблица ДвиженияССубконто, а не сам регистр.
	// У главной таблицы регистра бухгалтерии субконто нет как колонок: они
	// хранятся отдельно, и обращение к Хозрасчетный.СубконтоДт1 падает с
	// «Поле не найдено». Период задаётся параметрами таблицы, границы включаются
	Запрос.Текст =
	"ВЫБРАТЬ
	|	Хозрасчетный.Период КАК Период,
	|	Хозрасчетный.Регистратор КАК Регистратор,
	|	Хозрасчетный.НомерСтроки КАК НомерСтроки,
	|	Хозрасчетный.Организация КАК Организация,
	|	Хозрасчетный.Сумма КАК Сумма,
	|	Хозрасчетный.Содержание КАК Содержание,
	|	Хозрасчетный.СчетДт КАК СчетДт,
	|	Хозрасчетный.СчетКт КАК СчетКт,
	|	Хозрасчетный.КоличествоДт КАК КоличествоДт,
	|	Хозрасчетный.КоличествоКт КАК КоличествоКт,
	|	Хозрасчетный.СубконтоДт1 КАК СубконтоДт1,
	|	Хозрасчетный.СубконтоДт2 КАК СубконтоДт2,
	|	Хозрасчетный.СубконтоДт3 КАК СубконтоДт3,
	|	Хозрасчетный.СубконтоКт1 КАК СубконтоКт1,
	|	Хозрасчетный.СубконтоКт2 КАК СубконтоКт2,
	|	Хозрасчетный.СубконтоКт3 КАК СубконтоКт3
	|ИЗ
	|	РегистрБухгалтерии.Хозрасчетный.ДвиженияССубконто(&ДатаНачала, &ДатаОкончания) КАК Хозрасчетный
	|ГДЕ
	|	Хозрасчетный.Активность
	|	И (НЕ &ОтборПоОрганизации ИЛИ Хозрасчетный.Организация = &Организация)
	|УПОРЯДОЧИТЬ ПО
	|	Период,
	|	Регистратор,
	|	НомерСтроки";

	Выборка = Запрос.Выполнить().Выбрать();

	Проводки = Новый Массив;

	Пока Выборка.Следующий() Цикл

		// Проводки без суммы бывают у служебных движений (только количество или
		// только аналитика). Учёту в FINDIR они ничего не дают, а строк добавят
		Если Выборка.Сумма = 0 И Выборка.КоличествоДт = 0 И Выборка.КоличествоКт = 0 Тогда
			Продолжить;
		КонецЕсли;

		Проводка = Новый Структура;
		Проводка.Вставить("amount", Выборка.Сумма);
		ВставитьЕслиЕсть(Проводка, "id", ИдентификаторПроводки(Выборка.Регистратор, Выборка.НомерСтроки));
		ВставитьЕслиЕсть(Проводка, "date", ДатаВСтроку(Выборка.Период, Истина));
		ВставитьЕслиЕсть(Проводка, "document", ОписаниеДокумента(Выборка.Регистратор));
		ВставитьЕслиЕсть(Проводка, "content", ТекстИлиНичего(Выборка.Содержание));

		Проводка.Вставить("debit", СторонаПроводки(
			Выборка.СчетДт, Выборка.КоличествоДт,
			Выборка.СубконтоДт1, Выборка.СубконтоДт2, Выборка.СубконтоДт3));

		Проводка.Вставить("credit", СторонаПроводки(
			Выборка.СчетКт, Выборка.КоличествоКт,
			Выборка.СубконтоКт1, Выборка.СубконтоКт2, Выборка.СубконтоКт3));

		Проводки.Добавить(Проводка);

	КонецЦикла;

	Период = Новый Структура;
	Период.Вставить("from", ДатаВСтроку(НачалоДня(ДатаНачала), Ложь));
	Период.Вставить("to", ДатаВСтроку(НачалоДня(ДатаОкончания), Ложь));

	Выгрузка = Новый Структура;
	Выгрузка.Вставить("format", "findir-postings");
	Выгрузка.Вставить("version", 1);
	Выгрузка.Вставить("source", ОписаниеИсточника());
	ВставитьЕслиЕсть(Выгрузка, "organization", ОписаниеОрганизации(Организация));
	Выгрузка.Вставить("period", Период);
	Выгрузка.Вставить("exported_at", ДатаВСтроку(ТекущаяДатаСеанса(), Истина));
	Выгрузка.Вставить("entries", Проводки);

	Возврат Выгрузка;

КонецФункции

// Выгрузка как строка JSON.
//
// Форма пишет файл сама — так она может сделать это на клиенте, куда бы
// пользователь ни указал путь.
//
// ВАЖНО про пустые значения: ЗаписатьJSON не принимает ни Неопределено, ни Null.
// Обозначить пустоту значением нечем — пустое поле в структуру просто не кладём,
// для этого есть ВставитьЕслиЕсть.
//
// Перед записью зовём ПроверитьПередЗаписью: ЗаписатьJSON на любой посторонний
// тип отвечает «Значение содержит данные недопустимых типов» — без поля, без
// типа и без номера проводки, искать по такому сообщению нечего.
//
Функция ВыгрузкаВСтроку(Выгрузка) Экспорт

	ПроверитьПередЗаписью(Выгрузка);

	ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);

	Запись = Новый ЗаписьJSON;
	Запись.УстановитьСтроку(ПараметрыJSON);
	ЗаписатьJSON(Запись, Выгрузка);

	Возврат Запись.Закрыть();

КонецФункции

// Записывает выгрузку в файл на той стороне, где выполняется код.
//
// Нужна для запуска по расписанию (регламентное задание пишет на сервер).
// Кодировка UTF-8 БЕЗ BOM: третий параметр ОткрытьФайл — это признак BOM, и он
// обязан быть Ложь. С BOM приёмник получает мусорный символ в начале файла, и
// разбор JSON падает без внятной причины.
//
Процедура ЗаписатьВФайл(Выгрузка, ПутьКФайлу) Экспорт

	ПроверитьПередЗаписью(Выгрузка);

	ПараметрыJSON = Новый ПараметрыЗаписиJSON(ПереносСтрокJSON.Авто, Символы.Таб);

	Запись = Новый ЗаписьJSON;
	Запись.ОткрытьФайл(ПутьКФайлу, "UTF-8", Ложь, ПараметрыJSON);
	ЗаписатьJSON(Запись, Выгрузка);
	Запись.Закрыть();

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Служебные

// Устойчивый идентификатор проводки: GUID регистратора и номер строки движения.
// Перевыгрузили тот же период — идентификаторы те же, дублей на приёмнике нет.
Функция ИдентификаторПроводки(Регистратор, НомерСтроки)

	Если НЕ ЗначениеЗаполнено(Регистратор) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Возврат Строка(Регистратор.УникальныйИдентификатор()) + ":" + Формат(НомерСтроки, "ЧГ=0");

КонецФункции

Функция ОписаниеДокумента(Регистратор)

	Если НЕ ЗначениеЗаполнено(Регистратор) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("type", Строка(Регистратор.Метаданные().Синоним));

	// Номер и дата есть не у всякого регистратора: движения могут писаться
	// и не документом. Читаем через попытку, а не через список типов
	Попытка
		ВставитьЕслиЕсть(Описание, "number", СокрЛП(Строка(Регистратор.Номер)));
		ВставитьЕслиЕсть(Описание, "date", ДатаВСтроку(Регистратор.Дата, Ложь));
	Исключение
		// Ни номера, ни даты — ключей просто не будет
	КонецПопытки;

	Возврат Описание;

КонецФункции

// Одна сторона проводки: счёт, количество и субконто по порядку слотов.
Функция СторонаПроводки(Счет, Количество, Субконто1, Субконто2, Субконто3)

	Сторона = Новый Структура;
	ВставитьЕслиЕсть(Сторона, "account", ?(ЗначениеЗаполнено(Счет), СокрЛП(Строка(Счет.Код)), Неопределено));
	ВставитьЕслиЕсть(Сторона, "quantity", ?(Количество = 0, Неопределено, Количество));

	Список = Новый Массив;
	ДобавитьСубконто(Список, Субконто1);
	ДобавитьСубконто(Список, Субконто2);
	ДобавитьСубконто(Список, Субконто3);
	Сторона.Вставить("subconto", Список);

	Возврат Сторона;

КонецФункции

// Незаполненные слоты пропускаем, а не пишем как null: пустое субконто нечего
// сопоставлять, а порядок приёмник восстановит по виду (kind).
Процедура ДобавитьСубконто(Список, Значение)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат;
	КонецЕсли;

	Элемент = Новый Структура;
	Элемент.Вставить("kind", ИмяВидаСубконто(Значение));
	Элемент.Вставить("name", СокрЛП(Строка(Значение)));

	// Код и ИНН — необязательные, но по ним сопоставление точнее, чем по имени:
	// «ООО Ромашка» и «Ромашка, ООО» это одна организация и два разных имени
	Попытка
		ВставитьЕслиЕсть(Элемент, "code", СокрЛП(Строка(Значение.Код)));
	Исключение
		// У этого вида субконто нет кода — ключа не будет
	КонецПопытки;

	Попытка
		ИНН = СокрЛП(Строка(Значение.ИНН));
		Если НЕ ПустаяСтрока(ИНН) Тогда
			Элемент.Вставить("inn", ИНН);
		КонецЕсли;
	Исключение
		// У этого вида субконто нет ИНН — так и должно быть для номенклатуры,
		// статей затрат и прочих неконтрагентов
	КонецПопытки;

	Список.Добавить(Элемент);

КонецПроцедуры

// Имя вида субконто по метаданным: «Контрагенты», «Номенклатура», «СтатьиЗатрат».
// Приёмник по нему понимает, в какой справочник FINDIR смотреть.
Функция ИмяВидаСубконто(Значение)

	Попытка
		Возврат Строка(Значение.Метаданные().Имя);
	Исключение
		// Не ссылочный тип (число, строка, булево в субконто тоже бывают)
		Возврат Строка(ТипЗнч(Значение));
	КонецПопытки;

КонецФункции

// Версия функцией, а не переменной модуля. Переменная жила бы только пока
// выполнилось тело модуля, а тело модуля объекта выполняется не в любом
// сценарии создания обработки — и тогда в выгрузку уезжало бы Неопределено.
Функция ВерсияОбработки() Экспорт

	Возврат "1.0";

КонецФункции

Функция ОписаниеИсточника()

	Источник = Новый Структура;
	Источник.Вставить("app", "1С:Бухгалтерия");
	Источник.Вставить("config", Строка(Метаданные.Синоним) + " (" + Строка(Метаданные.Версия) + ")");
	Источник.Вставить("processing", ВерсияОбработки());

	Возврат Источник;

КонецФункции

Функция ОписаниеОрганизации(Организация)

	Если НЕ ЗначениеЗаполнено(Организация) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Описание = Новый Структура;
	Описание.Вставить("name", СокрЛП(Строка(Организация)));

	Попытка
		ВставитьЕслиЕсть(Описание, "inn", СокрЛП(Строка(Организация.ИНН)));
		ВставитьЕслиЕсть(Описание, "kpp", СокрЛП(Строка(Организация.КПП)));
	Исключение
		// Нетиповая конфигурация без этих реквизитов — не повод падать
	КонецПопытки;

	Возврат Описание;

КонецФункции

// ISO 8601 без метки пояса: 1С хранит время локальным, и «Z» означал бы
// точность, которой нет.
//
// Дату всегда отдаём строкой, а не самой датой: формат приёмнику нужен ровно
// ISO, и полагаться на то, как её запишет ЗаписатьJSON, незачем.
Функция ДатаВСтроку(Значение, СоВременем)

	Если НЕ ЗначениеЗаполнено(Значение) Тогда
		Возврат Неопределено;
	КонецЕсли;

	Если СоВременем Тогда
		Возврат Формат(Значение, "ДФ=yyyy-MM-ddTHH:mm:ss");
	КонецЕсли;

	Возврат Формат(Значение, "ДФ=yyyy-MM-dd");

КонецФункции

Функция ТекстИлиНичего(Значение)

	Строчка = СокрЛП(Строка(Значение));
	Возврат ?(ПустаяСтрока(Строчка), Неопределено, Строчка);

КонецФункции

// Кладёт значение в структуру, только если его есть что класть.
//
// Пустое поле не появляется в JSON вовсе — и это не стилистика. ЗаписатьJSON
// не принимает ни Неопределено, ни Null: обозначить пустоту значением нечем,
// любая попытка ломает запись целиком. Приёмник отсутствующий ключ и null
// читает одинаково, так что формат от этого не страдает.
Процедура ВставитьЕслиЕсть(Структура, Ключ, Значение)

	Тип = ТипЗнч(Значение);

	Если Тип = Тип("Неопределено") ИЛИ Тип = Тип("Null") Тогда
		Возврат;
	КонецЕсли;

	Если Тип = Тип("Строка") И ПустаяСтрока(Значение) Тогда
		Возврат;
	КонецЕсли;

	Структура.Вставить(Ключ, Значение);

КонецПроцедуры

// Ищет значение, которое ЗаписатьJSON записать не сможет.
//
// Сама ЗаписатьJSON говорит только «Значение содержит данные недопустимых
// типов» — без поля, без типа и без номера проводки. В выгрузке на тысячи
// строк искать такое вручную нечем, поэтому ищем до записи и называем путь.
//
// Возвращает описание первого найденного значения или пустую строку.
Функция НайтиНедопустимоеЗначение(Значение, Путь)

	Тип = ТипЗнч(Значение);

	Если Тип = Тип("Строка") ИЛИ Тип = Тип("Число") ИЛИ Тип = Тип("Булево") Тогда
		Возврат "";
	КонецЕсли;

	// Ни Неопределено, ни Null записать нельзя. Пустое поле в структуру просто
	// не кладём — для этого есть ВставитьЕслиЕсть
	Если Тип = Тип("Неопределено") ИЛИ Тип = Тип("Null") Тогда
		Возврат Путь + " — " + ?(Тип = Тип("Null"), "Null", "Неопределено")
			+ ", а пустое поле надо не заполнять, а не класть в структуру";
	КонецЕсли;

	Если Тип = Тип("Структура") ИЛИ Тип = Тип("ФиксированнаяСтруктура") Тогда
		Для Каждого КлючИЗначение Из Значение Цикл
			Найдено = НайтиНедопустимоеЗначение(КлючИЗначение.Значение, Путь + "." + КлючИЗначение.Ключ);
			Если НЕ ПустаяСтрока(Найдено) Тогда
				Возврат Найдено;
			КонецЕсли;
		КонецЦикла;
		Возврат "";
	КонецЕсли;

	Если Тип = Тип("Массив") ИЛИ Тип = Тип("ФиксированныйМассив") Тогда
		Для Индекс = 0 По Значение.ВГраница() Цикл
			Найдено = НайтиНедопустимоеЗначение(Значение[Индекс], Путь + "[" + Формат(Индекс, "ЧГ=0") + "]");
			Если НЕ ПустаяСтрока(Найдено) Тогда
				Возврат Найдено;
			КонецЕсли;
		КонецЦикла;
		Возврат "";
	КонецЕсли;

	Возврат Путь + " — тип «" + Строка(Тип) + "», значение: " + Строка(Значение);

КонецФункции

Процедура ПроверитьПередЗаписью(Выгрузка)

	Плохое = НайтиНедопустимоеЗначение(Выгрузка, "выгрузка");

	Если НЕ ПустаяСтрока(Плохое) Тогда
		ВызватьИсключение "В выгрузку попало значение, которое нельзя записать в JSON: " + Плохое;
	КонецЕсли;

КонецПроцедуры
