////////////////////////////////////////////////////////////////////////////////
// Модуль формы внешней обработки «Выгрузка проводок в FINDIR».
//
// Реквизиты формы (создаются в Конфигураторе, см. README.md):
//   ДатаНачала     - Дата (состав: Дата)
//   ДатаОкончания  - Дата (состав: Дата)
//   Организация    - СправочникСсылка.Организации
//   ПутьКФайлу     - Строка
//
// Команда формы: Выгрузить
////////////////////////////////////////////////////////////////////////////////

&НаСервере
Процедура ПриСозданииНаСервере(Отказ, СтандартнаяОбработка)

	// По умолчанию — прошлый месяц целиком: выгружают обычно закрытый период,
	// а не текущий, в котором проводки ещё добавляются
	ПрошлыйМесяц = ДобавитьМесяц(ТекущаяДатаСеанса(), -1);
	ДатаНачала = НачалоМесяца(ПрошлыйМесяц);
	ДатаОкончания = КонецМесяца(ПрошлыйМесяц);

	ПутьКФайлу = "";

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Обработчики команд

&НаКлиенте
Процедура Выгрузить(Команда)

	Если НЕ ЗначениеЗаполнено(ДатаНачала) ИЛИ НЕ ЗначениеЗаполнено(ДатаОкончания) Тогда
		ПоказатьПредупреждение(, "Укажите период выгрузки.");
		Возврат;
	КонецЕсли;

	Если ДатаНачала > ДатаОкончания Тогда
		ПоказатьПредупреждение(, "Начало периода позже его конца.");
		Возврат;
	КонецЕсли;

	Если ПустаяСтрока(ПутьКФайлу) Тогда
		ВыбратьФайл(Истина);
		Возврат;
	КонецЕсли;

	ВыполнитьВыгрузку();

КонецПроцедуры

&НаКлиенте
Процедура ПутьКФайлуНачалоВыбора(Элемент, ДанныеВыбора, СтандартнаяОбработка)

	СтандартнаяОбработка = Ложь;
	ВыбратьФайл(Ложь);

КонецПроцедуры

////////////////////////////////////////////////////////////////////////////////
// Основное

// ВыгружатьПослеВыбора — выбрали файл по нажатию «Выгрузить», значит сразу
// после выбора надо выгрузить, а не заставлять нажимать второй раз
&НаКлиенте
Процедура ВыбратьФайл(ВыгружатьПослеВыбора)

	Диалог = Новый ДиалогВыбораФайла(РежимДиалогаВыбораФайла.Сохранение);
	Диалог.Заголовок = "Куда сохранить выгрузку";
	Диалог.Фильтр = "Файл выгрузки FINDIR (*.json)|*.json";
	Диалог.Расширение = "json";
	Диалог.ПолноеИмяФайла = ИмяФайлаПоУмолчанию();

	Оповещение = Новый ОписаниеОповещения("ПослеВыбораФайла", ЭтотОбъект, ВыгружатьПослеВыбора);
	Диалог.Показать(Оповещение);

КонецПроцедуры

&НаКлиенте
Процедура ПослеВыбораФайла(ВыбранныеФайлы, ВыгружатьПослеВыбора) Экспорт

	Если ВыбранныеФайлы = Неопределено ИЛИ ВыбранныеФайлы.Количество() = 0 Тогда
		Возврат;
	КонецЕсли;

	ПутьКФайлу = ВыбранныеФайлы[0];

	Если ВыгружатьПослеВыбора = Истина Тогда
		ВыполнитьВыгрузку();
	КонецЕсли;

КонецПроцедуры

&НаКлиенте
Процедура ВыполнитьВыгрузку()

	Результат = СобратьНаСервере(ДатаНачала, ДатаОкончания, Организация);

	Если Результат.Количество = 0 Тогда
		ПоказатьПредупреждение(, "За выбранный период проводок нет — файл не создан.");
		Возврат;
	КонецЕсли;

	// Пишем через двоичные данные, а не ЗаписьТекста: третий параметр
	// ПолучитьДвоичныеДанныеИзСтроки — это BOM, и он должен быть Ложь.
	// ЗаписьТекста в UTF-8 ставит BOM, и приёмник спотыкается на первом символе
	Данные = ПолучитьДвоичныеДанныеИзСтроки(Результат.Текст, "UTF-8", Ложь);
	Данные.Записать(ПутьКФайлу);

	ПоказатьПредупреждение(, "Выгружено проводок: " + Результат.Количество
		+ Символы.ПС + "Файл: " + ПутьКФайлу);

КонецПроцедуры

&НаСервере
Функция СобратьНаСервере(ПериодС, ПериодПо, ВыбраннаяОрганизация)

	Обработка = РеквизитФормыВЗначение("Объект");

	Выгрузка = Обработка.СобратьВыгрузку(ПериодС, ПериодПо, ВыбраннаяОрганизация);

	Результат = Новый Структура;
	Результат.Вставить("Количество", Выгрузка.entries.Количество());
	Результат.Вставить("Текст", Обработка.ВыгрузкаВСтроку(Выгрузка));

	Возврат Результат;

КонецФункции

&НаКлиенте
Функция ИмяФайлаПоУмолчанию()

	Возврат "findir-postings-" + Формат(ДатаНачала, "ДФ=yyyy-MM-dd")
		+ "_" + Формат(ДатаОкончания, "ДФ=yyyy-MM-dd") + ".json";

КонецФункции
